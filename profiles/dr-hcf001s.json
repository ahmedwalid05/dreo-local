{
  "model": "DR-HCF001S",
  "type": "ceiling_fan",
  "module": { "chip": "bk7231n", "flash_size": "0x200000" },
  "license": {
    "comment": "factory CBOR blob {sn,signature,cert,key} — the irreplaceable secret. Offset moves between units, so a scan range is given; the sim seeds it at 0x1F2000.",
    "offset": "0x1F2000",
    "length": 256,
    "search_from": "0x1E0000",
    "search_to": "0x200000",
    "expect_markers": ["sn", "sig"]
  },
  "upload": {
    "endpoint": "/ota",
    "min_body": 1023,
    "max_body": 655360
  },
  "images": {
    "comment": "stock .rbl is the documented restore path (no stock copy survives a custom flash). reader is a flashdump-capable image booted only to extract the key.",
    "stock_rbl": "firmware/your-stock.rbl",
    "reader_rbl": null
  },
  "dp_map": {
    "2":  {"key": "lighton",    "type": "bool", "entity": "switch", "name": "Light"},
    "3":  {"key": "fanon",      "type": "bool", "entity": "switch", "name": "Fan"},
    "4":  {"key": "windlevel",  "type": "enum", "entity": "select", "name": "Speed", "range": [0, 12]},
    "5":  {"key": "mode",       "type": "enum", "entity": "select", "name": "Direction", "map": {"1": "Forward", "4": "Reverse"}},
    "6":  {"key": "brightness", "type": "enum", "entity": "number", "name": "Brightness", "range": [0, 100]},
    "7":  {"key": "colortemp",  "type": "int",  "entity": "number", "name": "Color Temp", "range": [0, 100]},
    "12": {"key": "muteon",     "type": "bool", "entity": "switch", "name": "Audio Feedback"}
  },
  "uart": { "baud": 115200, "framing": "55AA", "boot": "maintenance_ladder" },
  "semantics": { "write": "transitions_only" }
}
